// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        Int    @id @default(autoincrement())
  FirstName String @db.VarChar(15)
  LastName  String @db.VarChar(15)
  Email     String @unique @db.VarChar(100)
  Pseudo    String @unique @db.VarChar(15)
  password  String @db.VarChar(100)

  posts              post[]
  comments           comment[]
  familyMemberships  FamilyMember[]
  channelMemberships channelmember[]
  documents          genericdocument[]
  notifications      notification[]
  passports          passport[]
  idCards            idcard[]
  familiesCreated    family[]
  channelsCreated    channel[]
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(50)
}

model family {
  id             Int      @id @default(autoincrement())
  name           String   @map("Name") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      Int      @map("created_by")
  invitationCode String?  @unique @map("invitation_code") @db.VarChar(20)

  creator User           @relation(fields: [createdBy], references: [id])
  members FamilyMember[]
}

model FamilyMember {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  familyId Int      @map("family_id")
  role     String   @map("Role") @db.VarChar(50)
  joinedAt DateTime @default(now()) @map("joined_at")

  user   User   @relation(fields: [userId], references: [id])
  family family @relation(fields: [familyId], references: [id])

  @@unique([userId, familyId]) // evite que le même user soit dans la meme famille plusieurs fois
}

model comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  post post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model post {
  id        Int      @id @default(autoincrement()) // primary key
  userId    Int      @map("user_id")
  channelId Int      @map("channel_id")
  title     String   @db.VarChar(25)
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id])
  channel  channel   @relation(fields: [channelId], references: [id])
  comments comment[]
}

model friendship {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id") // qui a envoye la demande 
  friendId  Int      @map("friend_id") // qui a reu la demande 
  status    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, friendId]) // evite d'avoir deux fois la meme paire
}

model visibility {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(50)

  channels channel[]
}

model channelmember {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  channelId Int      @map("channel_id")
  role      String   @map("Role") @db.VarChar(50)
  joinedAt  DateTime @default(now()) @map("joined_at")

  user    User    @relation(fields: [userId], references: [id])
  channel channel @relation(fields: [channelId], references: [id])

  @@unique([userId, channelId]) // evite que le même user soit dans le meme channel plusieurs fois
}

model genericdocument {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  documentName   String   @map("document_name") @db.VarChar(100)
  documentType   String   @map("document_type") @db.VarChar(50)
  issuer         String   @db.VarChar(100)
  issueDate      DateTime @map("issue_date")
  expirationDate DateTime @map("expiration_date")
  fileurl        String   @map("file_url") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
}

model notification {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  type          String   @db.VarChar(50)
  title         String   @db.VarChar(100)
  message       String   @db.VarChar(255)
  isRead        Boolean  @default(false) @map("is_read")
  documenttable String   @map("document_table") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
}

model channel {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  description    String   @db.VarChar(255)
  visibilityId   Int      @map("visibility_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      Int      @map("created_by")
  invitationCode String?  @unique @map("invitation_code") @db.VarChar(20)

  visibility visibility      @relation(fields: [visibilityId], references: [id])
  creator    User            @relation(fields: [createdBy], references: [id])
  members    channelmember[]
  posts      post[]
}

model passport {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  passportNumber String   @map("passport_number") @db.VarChar(20)
  issueDate      DateTime @map("issue_date")
  expirationDate DateTime @map("expiration_date")
  countryOfIssue String   @map("country_of_issue") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")
  fileurl        String   @map("file_url") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id])
}

model idcard {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  idCardNumber   String   @map("id_card_number") @db.VarChar(20)
  issueDate      DateTime @map("issue_date")
  expirationDate DateTime @map("expiration_date")
  countryOfIssue String   @map("country_of_issue") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")
  fileurl        String   @map("file_url") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id])
}

// @id = primary key
// @unique avoids two users having the same name or the same email
