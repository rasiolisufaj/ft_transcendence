# ─────────────────────────────────────────────────────────────────────────────
# MesPapiers — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored and MUST NEVER be committed (subject III.3).
# This file is committed on purpose: it documents every key the project needs.
#
# docker compose reads `.env` at the repo root for ${...} interpolation
# in docker-compose.yml — same file, no extra flag needed.
# ─────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL (docker-compose service "db") --------------------------------
POSTGRES_USER=mespapiers
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=mespapiers

# --- Prisma ------------------------------------------------------------------
# host:port is localhost:5432 from your machine (port published by compose),
# and db:5432 from inside another container. Keep the two in sync with the
# POSTGRES_* values above.
DATABASE_URL="postgresql://mespapiers:change_me_locally@localhost:5432/mespapiers?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Keys below are planned in PROJECT_PLAN.md but not used by any code yet.
# Uncomment each one in the same PR that introduces the service it belongs to,
# so that `check:env` (PROJECT_PLAN A4) stays meaningful.
# ─────────────────────────────────────────────────────────────────────────────

# --- AI (Anthropic) — extraction + assistant, PROJECT_PLAN domain B ----------
# Used by src/lib/ai/extract.ts to classify a document on upload.
# Without it the app still runs: documents are saved and stay PENDING.
ANTHROPIC_API_KEY=sk-ant-replace-me
# DEMO_MODE=0                 # 1 = replay committed fixtures, offline defence (R10)

# --- Auth / sessions — PROJECT_PLAN domain C ---------------------------------
# Google sign-in (phase 8): a "Web application" OAuth client in the Google Cloud console, whose
# redirect URI is APP_URL + /api/auth/google/callback. Empty = the Google button sends you back
# to the login page with an error message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Signs the 60-second tickets the realtime process checks on connect (openssl rand -base64 32).
WS_TICKET_SECRET=change_me_locally

# --- Real-time / jobs — PROJECT_PLAN domain D --------------------------------
# Read by src/realtime/main.ts (npm run realtime). HEARTBEAT_MS = how often each client is pinged.
REALTIME_PORT=3001
HEARTBEAT_MS=30000
# Shared by web and realtime: web sends it on POST /publish (openssl rand -base64 32).
REALTIME_PUBLISH_SECRET=change_me_locally
# Where web posts events: http://localhost:3001 with npm run realtime; http://realtime:3001 once compose has a realtime service.
REALTIME_INTERNAL_URL=http://localhost:3001

# --- Object storage (MinIO) — PROJECT_PLAN domain E -------------------------
# MINIO_ROOT_USER=mespapiers
# MINIO_ROOT_PASSWORD=change_me_locally
# MINIO_ENDPOINT=http://minio:9000
# MINIO_BUCKET=documents

# --- Mail (Mailpit in dev) ---------------------------------------------------
# docker-compose hardcodes SMTP_HOST=mailpit for the web container; this value
# is for `npm run dev` on the host, where mailpit is reached on localhost.
SMTP_HOST=localhost
SMTP_PORT=1025

# --- App ---------------------------------------------------------------------
# The origin the browser is on. OAuth builds its redirect URI from it. Google refuses .local
# hosts: to test Google sign-in, set https://localhost here and open the app on that host.
APP_URL=https://mespapiers.local
