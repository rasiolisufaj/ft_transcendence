# ─────────────────────────────────────────────────────────────────────────────
# MesPapiers — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored and MUST NEVER be committed (subject III.3).
# This file is committed on purpose: it documents every key the project needs.
#
# docker compose reads `.env` at the repo root for ${...} interpolation
# in docker-compose.yml — same file, no extra flag needed.
# ─────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL (docker-compose service "db") --------------------------------
POSTGRES_USER=mespapiers
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=mespapiers

# --- Prisma ------------------------------------------------------------------
# host:port is localhost:5432 from your machine (port published by compose),
# and db:5432 from inside another container. Keep the two in sync with the
# POSTGRES_* values above.
DATABASE_URL="postgresql://mespapiers:change_me_locally@localhost:5432/mespapiers?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Keys below are planned in PROJECT_PLAN.md but not used by any code yet.
# Uncomment each one in the same PR that introduces the service it belongs to,
# so that `check:env` (PROJECT_PLAN A4) stays meaningful.
# ─────────────────────────────────────────────────────────────────────────────

# --- AI (Anthropic) — extraction + assistant, PROJECT_PLAN domain B ----------
# ANTHROPIC_API_KEY=sk-ant-replace-me
# DEMO_MODE=0                 # 1 = replay committed fixtures, offline defence (R10)

# --- Auth / sessions — PROJECT_PLAN domain C ---------------------------------
# AUTH_STUB=0                 # 1 = seeded session context; deleted in Week 2
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# WS_TICKET_SECRET=change_me_locally

# --- Real-time / jobs — PROJECT_PLAN domain D --------------------------------
# REDIS_URL=redis://redis:6379

# --- Object storage (MinIO) — PROJECT_PLAN domain E -------------------------
# MINIO_ROOT_USER=mespapiers
# MINIO_ROOT_PASSWORD=change_me_locally
# MINIO_ENDPOINT=http://minio:9000
# MINIO_BUCKET=documents

# --- Mail (Mailpit in dev) ---------------------------------------------------
# SMTP_HOST=mailpit
# SMTP_PORT=1025

# --- App ---------------------------------------------------------------------
# APP_URL=https://mespapiers.local
