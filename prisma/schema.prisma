generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "darwin"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelRole {
  MEMBER
  MODERATOR
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum NotificationType {
  DEADLINE
  REPLY
  MESSAGE
  FRIEND_REQUEST
  OTHER
}

enum GlobalRole {
  USER
  ADMIN
}

enum DocumentCategory {
  IDENTITY
  INSURANCE_AUTO
  OTHER
}

enum DeadlineType {
  HARD
  SOFT
  PERIODIC
  NONE
}

enum ExtractionStatus {
  PENDING
  NEEDS_REVIEW
  CONFIRMED
  FAILED
}

// a user of the site
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  displayName  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  avatarKey    String?
  locale       String     @default("fr")
  totpSecret   String?
  totpEnabled  Boolean    @default(false)
  globalRole   GlobalRole @default(USER)
  reputation   Int        @default(0)

  documents                   Document[]
  sessions                    Session[]
  channelsCreated             Channel[]
  channelMemberships          ChannelMember[]
  threads                     Thread[]             @relation("ThreadAuthor")
  answers                     Answer[]             @relation("AnswerAuthor")
  votes                       Vote[]
  friendshipsSent             Friendship[]         @relation("SentFriendships")
  friendshipsReceived         Friendship[]         @relation("ReceivedFriendships")
  conversationsAsParticipant1 Conversation[]       @relation("ConversationParticipant1")
  conversationsAsParticipant2 Conversation[]       @relation("ConversationParticipant2")
  messages                    Message[]            @relation("MessageSender")
  notifications               Notification[]
  oauthAccounts               OAuthAccount[]
  auditLogs                   AuditLog[]
  channelInvites              ChannelInvite[]
  channelJoinRequests         ChannelJoinRequest[]
}

// a document stored in the user vault
model Document {
  id        Int      @id @default(autoincrement())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String
  fileSize  Int
  fileData  Bytes
  fileHash  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  category         DocumentCategory @default(OTHER)
  extractionStatus ExtractionStatus @default(PENDING)

  targetDate   DateTime?
  deadlineType DeadlineType?

  identity      DocumentIdentity?
  insuranceAuto DocumentInsuranceAuto?

  @@unique([ownerId, fileHash])
  @@index([ownerId])
  @@index([ownerId, category])
  @@index([deadlineType, targetDate])
}

// fields read from an identity document
model DocumentIdentity {
  id         Int      @id @default(autoincrement())
  documentId Int      @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fullName       String
  birthDate      DateTime
  documentNumber String
  expiryDate     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

// fields read from a car insurance document
model DocumentInsuranceAuto {
  id         Int      @id @default(autoincrement())
  documentId Int      @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  provider     String
  policyNumber String
  vehiclePlate String
  expiryDate   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// a user who belongs to a channel
model ChannelMember {
  channelId Int         @map("channel_id")
  userId    String      @map("user_id")
  role      ChannelRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
}

// a community channel around one topic
model Channel {
  id           Int                  @id @default(autoincrement())
  createdBy    String?              @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at")
  title        String               @db.VarChar(100)
  description  String?              @db.VarChar(250)
  isPrivate    Boolean              @default(false)
  isClosed     Boolean              @default(false) @map("is_closed")
  creator      User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  members      ChannelMember[]
  threads      Thread[]
  invites      ChannelInvite[]
  joinRequests ChannelJoinRequest[]
  auditLogs    AuditLog[]
}

// the main question of a channel
model Thread {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(150)
  content   String   @db.VarChar(300)
  channelId Int      @unique @map("channel_id")
  userId    String?  @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  channel Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User?    @relation("ThreadAuthor", fields: [userId], references: [id], onDelete: SetNull)
  answers Answer[]
}

// a reply posted inside a thread
model Answer {
  id        Int      @id @default(autoincrement())
  content   String   @db.VarChar(300)
  threadId  Int      @map("thread_id")
  userId    String?  @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?  @relation("AnswerAuthor", fields: [userId], references: [id], onDelete: SetNull)
  votes  Vote[]
}

// a vote from a user on an answer plus one or minus one
model Vote {
  answerId  Int      @map("answer_id")
  userId    String   @map("user_id")
  value     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([answerId, userId])
}

// a link between two users as friends
model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId String           @map("requester_id")
  receiverId  String           @map("receiver_id")
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  requester User @relation("SentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

// a private chat between two users
model Conversation {
  id             Int      @id @default(autoincrement())
  participant1Id String   @map("participant1_id")
  participant2Id String   @map("participant2_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  participant1 User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([participant1Id, participant2Id])
}

// a message sent in a conversation
model Message {
  id             Int      @id @default(autoincrement())
  content        String   @db.Text
  conversationId Int      @map("conversation_id")
  senderId       String   @map("sender_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

// a notification sent to a user
model Notification {
  id          Int              @id @default(autoincrement())
  recipientId String           @map("recipient_id")
  type        NotificationType
  content     String           @db.VarChar(255)
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

// a login session
model Session {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  twoFactorVerified Boolean  @default(false)
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([userId])
}

// an oauth account linked to a user
model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([provider, providerUserId])
}

// one row per privileged action
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String
  channelId   Int?
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([channelId])
}

// an invite sent to a user to join a channel
model ChannelInvite {
  channelId Int      @map("channel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
}

// a request from a user to join a private channel
model ChannelJoinRequest {
  channelId Int      @map("channel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}
